<Window x:Class="Library_C__Group_Project.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_C__Group_Project"
        mc:Ignorable="d"
        Title="ReportWindow" Height="450" Width="800">
    <Grid>
        <ListView Name="ReportListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Customer" DisplayMemberBinding="{Binding CustomerName}" Width="150"/>
                    <GridViewColumn Header="Book Title" DisplayMemberBinding="{Binding BookTitle}" Width="200"/>
                    <GridViewColumn Header="Author" DisplayMemberBinding="{Binding BookAuthor}" Width="150"/>
                    <GridViewColumn Header="ISBN" DisplayMemberBinding="{Binding BookISBN}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
