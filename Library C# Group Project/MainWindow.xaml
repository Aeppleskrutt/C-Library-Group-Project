<Window x:Class="Library_C__Group_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_C__Group_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Library Management System"
               FontSize="24"
               Margin="0,0,0,20"
               TextAlignment="Center"/>

            <Button Name="BookButton"
            Click="BookButton_Click"
            Content="Manage Books"
            Height="40"
            Margin="50,0,50,15"/>

            <Button Name="CustomerButton"
            Click="CustomerButton_Click"
            Content="Manage Customers"
            Height="40"
            Margin="50,0,50,15"/>

            <Button Name="ReportButton"
            Click="ReportButton_Click"
            Content="Reports"
            Height="40"
            Margin="50,0,50,15" />

        </StackPanel>
    </Grid>
</Window>
