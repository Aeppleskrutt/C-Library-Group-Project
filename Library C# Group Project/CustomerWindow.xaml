<Window x:Class="Library_C__Group_Project.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_C__Group_Project"
        mc:Ignorable="d"
        Title="CustomerWindow" Height="500" Width="800">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">
            <TextBlock Text="Name"/>
            <TextBox Name="NameTextBox"/>

            <TextBlock Text="Customer ID"/>
            <TextBox Name="CustomerIDTextBox"/>
        </StackPanel>
        
        <Button Grid.Row="1"
                Name="AddCustomerButton"
                Content="Add Customer"
                Height="30"
                Margin="50,10,400,10" 
                Click="AddCustomerButton_Click"/>

        <Button Grid.Row="1"
                Name="RemoveCustomerButton"
                Content="Remove Selected Customer"
                Height="30"
                Margin="400,10,50,10" 
                Click="RemoveCustomerButton_Click"/>

        <StackPanel Grid.Row="2" Margin="0,0,10,0">
            <TextBlock Text="Customers"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

            <ListBox Name="CustomersListBox"
                 Height="150"
                 SelectionChanged="CustomersListBox_SelectionChanged"/>
        </StackPanel>
        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Text="Loaned Books"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

                <ListBox Name="LoanedBooksListBox"
                 Height="125"
                 />
            </StackPanel>
            
            <StackPanel Grid.Column="1" Margin="10,0,10,0">
            <TextBlock Text="Available Books"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

                <ComboBox Name="AvailableBooksComboBox"
                  Height="35"
                  Margin="0,0,0,10"/>

                <Button Name="LoanBookButton"
                Content="Loan Selected Book"
                Height="35"
                Margin="0,0,0,10"
                Click="LoanBookButton_Click"/>

                <Button Name="ReturnBookButton"
                Content="Return Selected Book"
                Height="35"
                Click="ReturnBookButton_Click"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>
